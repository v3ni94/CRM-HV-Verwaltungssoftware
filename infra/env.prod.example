# /opt/mhvp/.env.prod on the own server (chmod 600, never in git). Copy, then replace every
# change-me. Passwords: `openssl rand -hex 24` (URL safe). Staging: same file as .env.staging
# with its own passwords, MHVP_ENV=staging, MHVP_TRAEFIK_PREFIX=mhvp-staging and own hosts.
MHVP_ENV=prod
MHVP_LOG_LEVEL=INFO
MHVP_LOG_FORMAT=json

POSTGRES_PASSWORD=change-me
MHVP_DB_NAME=mhvp
MHVP_DB_MIGRATOR_PASSWORD=change-me
MHVP_DB_APP_PASSWORD=change-me

# Object storage: local SeaweedFS container "objectstore" of the stack is the standard
# (ADR 0005, Nachtrag 27.09.2026; docs/runbooks/objektspeicher-ionos-s3.md section 0). The key
# pair below is created by the operator (any two random strings, e.g. openssl rand -hex 16 and
# openssl rand -hex 32); the container accepts exactly this pair. Optional IONOS S3 instead:
# MHVP_S3_ENDPOINT_URL=https://[Endpunkt laut IONOS-Konsole], MHVP_S3_REGION=[Region], keys
# from the IONOS console, see sections 2 to 4 of the runbook.
MHVP_S3_ENDPOINT_URL=http://objectstore:8333
MHVP_S3_REGION=us-east-1
MHVP_S3_ACCESS_KEY_ID=change-me
MHVP_S3_SECRET_ACCESS_KEY=change-me
# Bucket names are global per IONOS contract; staging uses its own bucket (mhvp-staging).
MHVP_S3_BUCKET=mhvp

# Malware scan (Betreiberentscheidung 27.09.2026, docs/runbooks/virenscan.md): in prod and
# staging only enforce is accepted; the clamav service of the stack answers on clamav:3310.
MHVP_CLAMAV_MODE=enforce
#MHVP_CLAMAV_HOST=clamav
#MHVP_CLAMAV_PORT=3310
#MHVP_CLAMAV_TIMEOUT_SECONDS=30

# Generate once with the api image:
#   docker run --rm local/mhvp-api:<tag> python -m mhvp.core.auth.keys
# Keep a sealed copy off the server: without MHVP_MASTER_KEY encrypted fields are unreadable,
# also after a restore.
MHVP_MASTER_KEY=change-me
MHVP_JWT_PRIVATE_KEY=change-me
MHVP_JWT_ISSUER=https://api.mueller-holding.ag
MHVP_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Gmail mailboxes (M20-01): OAuth client of the platform, scope gmail.readonly; the refresh
# token per mailbox is stored encrypted via PATCH /api/v1/mail/mailboxes/{id}.
# Optional fallback; the OAuth client is normally entered per tenant on the settings page.
MHVP_GOOGLE_CLIENT_ID=
MHVP_GOOGLE_CLIENT_SECRET=
# Public API origin for the Google redirect URI and the web app the OAuth callback returns to.
MHVP_API_PUBLIC_URL=https://api.mueller-holding.ag
MHVP_WEB_CRM_URL=https://crm.mueller-holding.ag
MHVP_GMAIL_SYNC_BATCH=50
# Gmail push via Google Cloud Pub/Sub (operator 26.09.2026, docs/integrations/gmail.md): full
# topic name projects/<project-id>/topics/<name> (empty = push off, 5 minute beat sync only),
# shared secret of the push endpoint (query ?token= or header X-MHVP-Push-Token), optional
# OIDC audience of the push subscription (needs outbound access to www.googleapis.com).
MHVP_GMAIL_PUBSUB_TOPIC=
MHVP_GMAIL_PUSH_TOKEN=
MHVP_GMAIL_PUSH_AUDIENCE=
# FinTS/HBCI PIN/TAN (operator 27.09.2026, docs/integrations/fints.md): registration number of
# the product with the Deutsche Kreditwirtschaft (free "Antrag auf Produktregistrierung").
# Empty = no FinTS connection possible (MHVP-BANK-0007). Read only, no payments (G2 closed).
MHVP_FINTS_PRODUCT_ID=
#MHVP_FINTS_PRODUCT_VERSION=1.0
# Subnet of the Traefik network (docker network inspect <network> -> Subnet); operator server:
# traefik-proxy = 172.25.0.0/16 (checked 24.09.2026)
MHVP_FORWARDED_ALLOW_IPS=172.25.0.0/16

MHVP_API_INTERNAL_URL=http://api:8000
# Object take over system (objektakte, M29) linked from the DMS area.
MHVP_DMS_URL=https://uebernahme.muellerhv.de
# Directory on the worker with the objektakte mysqldump exports for the daily differential
# import (M35 Stufe 5). A tenant's dump path must lie inside it (symlinks resolved); mount it
# read only into the worker container. Size limit per export file in bytes (default 512 MiB).
MHVP_OBJEKTAKTE_DUMP_DIR=/data/objektakte-export
#MHVP_OBJEKTAKTE_DUMP_MAX_BYTES=536870912
# objektakte read API (M29 Stufe 4): base URL ".../api/crm/v1/", token from
# `crm_token anlegen --name crm --scopes objects:read documents:read persons:read` in objektakte,
# HMAC secret of the outgoing objektakte webhooks (CRM_WEBHOOK_SECRET there) and the tenant slug
# whose data objektakte holds. Empty values switch the connection off.
OBJEKTAKTE_API_URL=
OBJEKTAKTE_API_TOKEN=
OBJEKTAKTE_WEBHOOK_SECRET=
OBJEKTAKTE_TENANT=hausverwaltung-mueller
# Upload of CRM documents to objektakte (filing in Drive with owner and tenant files and in
# Paperless there; the CRM's own Paperless and Drive mirrors are skipped for those documents).
# Needs a token with documents:write and sync.crm_uploads_enabled in objektakte.
OBJEKTAKTE_UPLOAD_ENABLED=false

# Images (M1-03, decided 26.09.2026): GitHub Container Registry ghcr.io/v3ni94 (private), tag =
# content of the VERSION file, built by .github/workflows/images.yml. Login on the server once
# with a fine grained PAT (read:packages), see docs/runbooks/server-setup.md section 4.
# Fallback without registry: MHVP_IMAGE_REGISTRY=local and build on the server (DEPLOY_BUILD=1).
MHVP_IMAGE_REGISTRY=ghcr.io/v3ni94
MHVP_IMAGE_TAG=change-me

# Traefik: existing proxy of the operator server (network traefik-proxy, resolver letsencrypt);
# with infra/compose.edge.yaml use mhvp-edge and le instead
TRAEFIK_NETWORK=traefik-proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
MHVP_TRAEFIK_PREFIX=mhvp
# Defaults of the specification (3.1); DNS A/AAAA records must point to the server
MHVP_HOST_CRM=crm.mueller-holding.ag
MHVP_HOST_API=api.mueller-holding.ag
# Login paths per client address and minute (Traefik, M9-05). The web apps call the API from
# their own server: if they reach it through Traefik, raise the value or exempt their address.
MHVP_AUTH_RATELIMIT_PER_MINUTE=30
# portal.muellerhv.de is in use by the Immoware24 portal (DNS 24.09.2026): do not take it over
# during the parallel run. Until an own HVM portal host is decided, both point to one host.
MHVP_HOST_PORTAL_HVM=portal.mueller-holding.ag
MHVP_HOST_PORTAL_MHAG=portal.mueller-holding.ag
# Uptime Kuma (monitoring and alerts, M9-04): placeholder subdomain, DNS record required; the
# administrator account is created in the browser at the first call (docs/runbooks/monitoring.md).
MHVP_HOST_MONITORING=[Subdomain, z. B. status.mueller-holding.ag]
# Beszel (Host- und Container-Metriken, M9-04, Betreiberentscheidung 27.09.2026): Platzhalter-
# Subdomain, DNS-Eintrag erforderlich; das Erstkonto wird im Browser beim ersten Aufruf angelegt
# (docs/runbooks/monitoring.md).
MHVP_HOST_METRICS=[Subdomain, z. B. metrik.mueller-holding.ag]
# Beszel-Agent: im Hub unter Einstellungen, Systeme, neues System einen öffentlichen Schlüssel
# (KEY) und ein Registrierungs-Token (TOKEN) erzeugen und hier eintragen; ohne diese Werte
# startet der Agent nicht (docs/runbooks/monitoring.md).
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=

# Multi core sizing (operator server: 32 cores, 64 threads, 251 GB RAM, shared with other
# stacks). API processes, Celery processes and PostgreSQL memory. Connection budget:
# MHVP_API_WORKERS x 15 + MHVP_WORKER_CONCURRENCY x 2 must stay below PG_MAX_CONNECTIONS.
MHVP_API_WORKERS=8
MHVP_WORKER_CONCURRENCY=16
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=16GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_MAX_CONNECTIONS=300
PG_MAX_PARALLEL_WORKERS=16
PG_SHM_SIZE=2g
# WAL archiving (docs/runbooks/backup.md, "WAL-Archivierung"): host directory of the archive,
# writable by uid 999; same value as BACKUP_WAL_DIR in .env.backup. PG_ARCHIVE_MODE=off disables.
BACKUP_WAL_DIR=/srv/mhvp-backup/wal
PG_ARCHIVE_MODE=on
# Backup directory mounted read only into the API for the off-site status in /platform/ops/metrics.
BACKUP_DIR=/srv/mhvp-backup
