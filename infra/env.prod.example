# /opt/mhvp/.env.prod on the own server (chmod 600, never in git). Copy, then replace every
# change-me. Passwords: `openssl rand -hex 24` (URL safe). Staging: same file as .env.staging
# with its own passwords, MHVP_ENV=staging, MHVP_TRAEFIK_PREFIX=mhvp-staging and own hosts.
MHVP_ENV=prod
MHVP_LOG_LEVEL=INFO
MHVP_LOG_FORMAT=json

POSTGRES_PASSWORD=change-me
MHVP_DB_NAME=mhvp
MHVP_DB_MIGRATOR_PASSWORD=change-me
MHVP_DB_APP_PASSWORD=change-me

MHVP_S3_ACCESS_KEY_ID=change-me
MHVP_S3_SECRET_ACCESS_KEY=change-me
MHVP_S3_BUCKET=mhvp

# Generate once with the api image:
#   docker run --rm local/mhvp-api:<tag> python -m mhvp.core.auth.keys
# Keep a sealed copy off the server: without MHVP_MASTER_KEY encrypted fields are unreadable,
# also after a restore.
MHVP_MASTER_KEY=change-me
MHVP_JWT_PRIVATE_KEY=change-me
MHVP_JWT_ISSUER=https://api.mueller-holding.ag
MHVP_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# Docker network of Traefik (docker network inspect mhvp-edge -> Subnet)
MHVP_FORWARDED_ALLOW_IPS=change-me

MHVP_API_INTERNAL_URL=http://api:8000

# Images: DEPLOY_BUILD=1 builds on the server (registry "local")
MHVP_IMAGE_REGISTRY=local
MHVP_IMAGE_TAG=change-me

# Traefik: own edge proxy (infra/compose.edge.yaml) or an existing one
TRAEFIK_NETWORK=mhvp-edge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
MHVP_TRAEFIK_PREFIX=mhvp
# Defaults of the specification (3.1); DNS A/AAAA records must point to the server
MHVP_HOST_CRM=crm.mueller-holding.ag
MHVP_HOST_API=api.mueller-holding.ag
MHVP_HOST_PORTAL_HVM=portal.muellerhv.de
MHVP_HOST_PORTAL_MHAG=portal.mueller-holding.ag
