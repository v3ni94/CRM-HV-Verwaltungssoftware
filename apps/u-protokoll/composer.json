{
    "name": "muellerhv/u-protokoll",
    "description": "U-Protokoll – Digitales Übergabe- und Abnahmeprotokoll der Hausverwaltung Müller GmbH",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
