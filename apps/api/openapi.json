{
  "components": {
    "schemas": {
      "CheckResult": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "status",
          "latency_ms"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "CheckStatus": {
        "enum": [
          "ok",
          "fail"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "HealthReport": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Checks",
            "type": "object"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "checks"
        ],
        "title": "HealthReport",
        "type": "object"
      },
      "LiveReport": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version"
        ],
        "title": "LiveReport",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Offene REST-API der MH Verwaltungsplattform. Fachbegriffe deutsch, Feldnamen englisch. Fehler als RFC 9457 Problem Details (application/problem+json).",
    "title": "MH Verwaltungsplattform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveReport"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Prozess läuft (Liveness)",
        "tags": [
          "Betrieb"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            },
            "description": "Mindestens eine Prüfung ist fehlgeschlagen."
          }
        },
        "summary": "Abhängigkeiten erreichbar (Readiness)",
        "tags": [
          "Betrieb"
        ]
      }
    }
  }
}
