# /opt/mhvp/.env.backup on the server (chmod 600, never in git). Used by the systemd units in
# infra/systemd and by scripts/deploy.sh before production migrations.
PGDATABASE=mhvp
BACKUP_COMPOSE="docker compose -p mhvp --env-file .env.prod -f infra/compose.yaml -f infra/compose.prod.yaml"
BACKUP_DIR=/srv/mhvp-backup
BACKUP_RETENTION_DAYS=30
# Public age key (age-keygen -y key.txt). The private key is kept OFF the server.
BACKUP_AGE_RECIPIENT=age1change-me
# Document store volume of the local SeaweedFS container (standard since 27.09.2026, ADR 0005):
# archived as mhvp-objects-<STAMP>.tar.age with every run and copied off-site with the dump.
# Name = compose project + volume: mhvp_objectstore-data (staging: mhvp-staging_objectstore-data).
# Only with an optional external IONOS bucket leave it empty and use BACKUP_SOURCE_S3_* below.
BACKUP_OBJECTSTORE_VOLUME=mhvp_objectstore-data
# Off-site target reachable by SSH key, e.g. a second machine or storage box (optional, rsync)
BACKUP_REMOTE=
# Off-site copy to the operator's existing Hetzner S3 compatible Object Storage (M9-02,
# decision 26.09.2026; scripts/backup-offsite.sh, docs/runbooks/backup.md section
# "Off-site-Kopie"). Endpoint and region are copied from the Hetzner console; this file
# carries no hostnames. Leaving BACKUP_S3_BUCKET empty disables the off-site copy.
BACKUP_S3_ENDPOINT_URL=https://[Endpunkt laut Hetzner-Konsole]
BACKUP_S3_REGION=[Region laut Hetzner-Konsole]
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket (runs/ and objects/ are created below it)
BACKUP_S3_PREFIX=mhvp
# Public age key used for the off-site copy; defaults to BACKUP_AGE_RECIPIENT. NEVER the
# private key (AGE-SECRET-KEY-...): the script refuses it.
BACKUP_AGE_PUBLIC_KEY=
# Retention of the dated run prefixes in the bucket (GFS): newest daily runs, first run of
# the newest ISO weeks, first run of the newest months. Documents under objects/ are never
# pruned by the script.
BACKUP_OFFSITE_KEEP_DAILY=14
BACKUP_OFFSITE_KEEP_WEEKLY=8
BACKUP_OFFSITE_KEEP_MONTHLY=12
# Documents from an optional external IONOS bucket only (read only copy with the second key
# pair "Sicherung", docs/runbooks/objektspeicher-ionos-s3.md section 3). With the local
# objectstore (standard) the documents are already in the volume archive: leave the bucket empty.
BACKUP_SOURCE_S3_ENDPOINT_URL=https://[Endpunkt laut IONOS-Konsole]
BACKUP_SOURCE_S3_REGION=[Region laut IONOS-Konsole]
BACKUP_SOURCE_S3_BUCKET=
BACKUP_SOURCE_S3_ACCESS_KEY_ID=
BACKUP_SOURCE_S3_SECRET_ACCESS_KEY=
# WAL archive directory (archive_command target of compose.prod.yaml, same value as in .env.prod)
BACKUP_WAL_DIR=/srv/mhvp-backup/wal
# Restore test needs the private key: mount it only for the monthly test, then remove it
BACKUP_AGE_IDENTITY=/root/mhvp-restore-key.txt
# Health check
HEALTH_URL=https://api.mueller-holding.ag/api/v1/health/ready
BACKUP_MAX_AGE_HOURS=26
# Alarm target of healthcheck.sh and backup.sh (failures only, M9-04): Uptime Kuma push URL of
# the monitor "Server Skripte" with status=down, see docs/runbooks/monitoring.md section 4.
ALERT_WEBHOOK_URL=

# Deletion journal (D47): exported with every dump. In compose mode the default command is
# used; set BACKUP_JOURNAL_CMD only for another setup. BACKUP_SKIP_JOURNAL=1 disables it on purpose.
# BACKUP_JOURNAL_CMD=
BACKUP_JOURNAL_SINCE=2000-01-01
