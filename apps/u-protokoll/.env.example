# U-Protokoll – Konfigurationsbeispiel
# Diese Datei nach ".env" kopieren und Werte eintragen.
# Die .env liegt AUSSERHALB des Webroots (public/) und darf nie ins Repository.

APP_URL=https://u-protokoll.muellerhv.de
APP_DEBUG=0
APP_TIMEZONE=Europe/Berlin

# MariaDB 10 (utf8mb4)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u_protokoll
DB_USER=u_protokoll
DB_PASSWORD=

# SMTP-Versand (z. B. PHPMailer über den Provider-SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=u-protokoll@muellerhv.de
SMTP_PASSWORD=
SMTP_FROM=u-protokoll@muellerhv.de
SMTP_FROM_NAME="Hausverwaltung Müller GmbH"
SMTP_REPLY_TO=

# Dateispeicher: local oder sftp
STORAGE_DRIVER=local
# Bei local: absoluter Pfad außerhalb des Webroots
STORAGE_BASE_PATH=/var/www/u-protokoll/storage/uploads

# Bei STORAGE_DRIVER=sftp:
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
# Alternativ Key-Authentifizierung (Pfad zum privaten Schlüssel):
SFTP_KEY_FILE=
SFTP_BASE_PATH=/u-protokoll
