# /opt/mhvp/.env.backup on the server (chmod 600, never in git). Used by the systemd units in
# infra/systemd and by scripts/deploy.sh before production migrations.
PGDATABASE=mhvp
BACKUP_COMPOSE="docker compose -p mhvp --env-file .env.prod -f infra/compose.yaml -f infra/compose.prod.yaml"
BACKUP_DIR=/srv/mhvp-backup
BACKUP_RETENTION_DAYS=30
# Public age key (age-keygen -y key.txt). The private key is kept OFF the server.
BACKUP_AGE_RECIPIENT=age1change-me
# Document store volume (docker volume ls | grep objectstore)
BACKUP_OBJECTSTORE_VOLUME=mhvp_objectstore-data
# Off-site target reachable by SSH key, e.g. a second machine or storage box
BACKUP_REMOTE=
# Restore test needs the private key: mount it only for the monthly test, then remove it
BACKUP_AGE_IDENTITY=/root/mhvp-restore-key.txt
# Health check
HEALTH_URL=https://api.mueller-holding.ag/api/v1/health/ready
BACKUP_MAX_AGE_HOURS=26
ALERT_WEBHOOK_URL=
