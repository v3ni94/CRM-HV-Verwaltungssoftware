{
  "extends": "@mhvp/config/tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ]
  },
  "include": [
    "*.mts",
    "*.ts",
    ".next-check/types/**/*.ts",
    ".next-r12/types/**/*.ts",
    ".next/types/**/*.ts",
    "e2e",
    "next-env.d.ts",
    "src",
    ".next-e2e-rel/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
