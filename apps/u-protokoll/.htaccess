# Schutz für den Fall, dass der Projektstamm statt public/ als Webroot dient:
# Konfigurations- und Composer-Dateien sowie interne Verzeichnisse sind nie abrufbar.
<FilesMatch "^(\.env.*|composer\.(json|lock)|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 403 ^/(app|bin|database|storage|vendor|docs)(/|$)
</IfModule>
