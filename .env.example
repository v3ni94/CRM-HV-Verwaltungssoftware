# MHVP environment (docs/plans/M1.md section 4.1). Copy to .env and replace every change-me.
# .env is git ignored. Passwords end up in connection URLs: use URL-safe characters only
# (e.g. `openssl rand -hex 24`).

# Runtime
MHVP_ENV=dev
MHVP_LOG_LEVEL=INFO
MHVP_LOG_FORMAT=json
MHVP_APP_VERSION=0.1.0

# PostgreSQL (superuser only for the container and bootstrap)
POSTGRES_PASSWORD=change-me
MHVP_DB_NAME=mhvp
MHVP_DB_MIGRATOR_PASSWORD=change-me
MHVP_DB_APP_PASSWORD=change-me
# Optional overrides. In compose they default to URLs built from the passwords above
# (host postgres). For native runs outside Docker use host localhost:
# MHVP_DATABASE_URL=postgresql+psycopg://mhvp_app:change-me@localhost:5432/mhvp
# MHVP_MIGRATION_DATABASE_URL=postgresql+psycopg://mhvp_migrator:change-me@localhost:5432/mhvp

# Redis / Celery (compose defaults shown)
MHVP_REDIS_URL=redis://redis:6379/0
MHVP_CELERY_BROKER_URL=redis://redis:6379/1
MHVP_CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3 object storage (SeaweedFS in dev/CI, ADR 0005)
MHVP_S3_ENDPOINT_URL=http://objectstore:8333
MHVP_S3_REGION=us-east-1
MHVP_S3_ACCESS_KEY_ID=change-me
MHVP_S3_SECRET_ACCESS_KEY=change-me
MHVP_S3_BUCKET=mhvp

# Reverse proxy addresses trusted for X-Forwarded-* (Traefik network CIDR, never *)
MHVP_FORWARDED_ALLOW_IPS=127.0.0.1

# Auth and field encryption (M2). Generate with:
#   cd apps/api && uv run python -m mhvp.core.auth.keys
MHVP_MASTER_KEY=change-me
MHVP_JWT_PRIVATE_KEY=change-me
MHVP_JWT_ISSUER=http://api.localhost
# Dev only: allow webhook targets on private networks (refused in staging/prod)
MHVP_WEBHOOK_ALLOW_PRIVATE_TARGETS=true
# Optional initial administrator for `make seed` (TOTP setup at first login)
# MHVP_SEED_ADMIN_EMAIL=
# MHVP_SEED_ADMIN_PASSWORD=
# MHVP_SEED_ADMIN_NAME=

# Web apps (server side)
MHVP_API_INTERNAL_URL=http://api:8000

# Production / staging only (infra/compose.prod.yaml)
# MHVP_IMAGE_REGISTRY=ghcr.io/change-me
# MHVP_IMAGE_TAG=0.1.0
# TRAEFIK_NETWORK=change-me
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=change-me
# MHVP_TRAEFIK_PREFIX=mhvp
# MHVP_HOST_CRM=crm.mueller-holding.ag
# MHVP_HOST_API=api.mueller-holding.ag
# MHVP_HOST_PORTAL_HVM=portal.muellerhv.de
# MHVP_HOST_PORTAL_MHAG=portal.mueller-holding.ag
